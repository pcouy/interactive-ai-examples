---
import { Content as HomeContent } from '../content/home.md';
import { ui } from '../i18n/site';
import Base from '../layouts/Base.astro';
---

<Base title={`${ui.fr.siteName} — ${ui.fr.home.titleSuffix}`}>
  <section class="home-hero">
    <div class="home-hero__inner">
      <div>
        <p class="eyebrow">{ui.fr.home.eyebrow}</p>
        <h1>{ui.fr.home.title}</h1>
        <p class="lede">{ui.fr.home.lede}</p>
        <div class="home-actions">
          <a class="button button--primary" href="/deep-blue">{ui.fr.home.deepBlueCta}</a>
          <a class="button button--ghost" href="/frozen-lake">{ui.fr.home.frozenLakeCta}</a>
        </div>
        <p class="home-meta">{ui.fr.home.meta}</p>
      </div>

      <div class="home-motif" aria-hidden="true">
        <span class="home-motif__cell home-motif__cell--start"></span>
        <span class="home-motif__cell"></span>
        <span class="home-motif__cell home-motif__cell--hole"></span>
        <span class="home-motif__cell home-motif__cell--hole"></span>
        <span class="home-motif__cell"></span>
        <span class="home-motif__cell"></span>
        <span class="home-motif__cell home-motif__cell--hole"></span>
        <span class="home-motif__cell"></span>
        <span class="home-motif__cell"></span>
        <span class="home-motif__cell home-motif__cell--hole"></span>
        <span class="home-motif__cell"></span>
        <span class="home-motif__cell home-motif__cell--hole"></span>
        <span class="home-motif__cell home-motif__cell--hole"></span>
        <span class="home-motif__cell"></span>
        <span class="home-motif__cell"></span>
        <span class="home-motif__cell home-motif__cell--goal"></span>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="demos-title">
    <h2 class="section-title" id="demos-title">{ui.fr.home.demosTitle}</h2>
    <div class="card-grid">
      <article class="card">
        <p class="card__eyebrow">{ui.fr.eyebrowDeepBlue}</p>
        <h3 class="card__title">{ui.fr.nav.deepBlue}</h3>
        <p class="card__body">{ui.fr.home.deepBlueBody}</p>
        <a class="card__link" href="/deep-blue" aria-label={ui.fr.home.cardLinkDeepBlue}>{ui.fr.home.cardLink}</a>
      </article>

      <article class="card">
        <p class="card__eyebrow">{ui.fr.eyebrowFrozenLake}</p>
        <h3 class="card__title">{ui.fr.nav.frozenLake}</h3>
        <p class="card__body">{ui.fr.home.frozenLakeBody}</p>
        <a class="card__link" href="/frozen-lake" aria-label={ui.fr.home.cardLinkFrozenLake}>{ui.fr.home.cardLink}</a>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="about-title">
    <h2 class="section-title" id="about-title">{ui.fr.home.aboutTitle}</h2>
    <div class="prose">
      <HomeContent />
    </div>
  </section>
</Base>
