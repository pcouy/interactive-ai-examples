---
import { DEMO_LOG_MESSAGES } from '../../../../src/components/drl-deep-blue-page/demo-log-messages.js';
import { Content, frontmatter } from '../../content/en/deep-blue.md';
import { ui } from '../../i18n/site';
import DemoPage from '../../layouts/DemoPage.astro';
import deepBlueGlue from '../../scripts/deep-blue-demo.js?raw';
---

<DemoPage
  title={frontmatter.title}
  description={frontmatter.description}
  eyebrow={ui.en.eyebrowDeepBlue}
  wide
  lang="en"
>
  <Fragment slot="demo">
    <section class="demo-surface">
      <div class="demo-stage">
        <drl-deep-blue-page
          id="deep-blue-demo"
          game="tic-tac-toe"
          lang="en"></drl-deep-blue-page>
        <p
          class="demo-log"
          data-demo-log
          data-labels={JSON.stringify(DEMO_LOG_MESSAGES.en)}
          aria-live="polite"></p>
      </div>
    </section>
  </Fragment>

  <Content />

  <Fragment slot="scripts">
    <script is:inline type="module" src="/demo/drl-demos.js"></script>
    <script is:inline type="module" set:html={deepBlueGlue}></script>
  </Fragment>
</DemoPage>
