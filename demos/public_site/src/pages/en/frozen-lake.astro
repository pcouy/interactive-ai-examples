---
import { Content, frontmatter } from '../../content/en/frozen-lake.md';
import { ui } from '../../i18n/site';
import DemoPage from '../../layouts/DemoPage.astro';
import frozenLakeGlue from '../../scripts/frozen-lake-demo.js?raw';

const labels = ui.en.sliders;
---

<DemoPage
  title={frontmatter.title}
  description={frontmatter.description}
  eyebrow={ui.en.eyebrowFrozenLake}
  lang="en"
>
  <Fragment slot="demo">
    <section class="demo-surface">
      <div class="demo-stage">
        <drl-frozen-lake id="frozen-lake-demo" speed="1" lang="en">
          <div class="demo-controls">
            <drl-slider
              data-param="learning-rate"
              label={labels.learningRate}
              min="0.01"
              max="1"
              step="0.01"
              value="0.1"
              lang="en"></drl-slider>
            <drl-slider
              data-param="epsilon"
              label={labels.epsilon}
              min="0"
              max="1"
              step="0.01"
              value="0.1"
              lang="en"></drl-slider>
            <drl-slider
              data-param="discount-factor"
              label={labels.discountFactor}
              min="0.5"
              max="1"
              step="0.01"
              value="0.99"
              lang="en"></drl-slider>
            <drl-slider
              data-param="slip-probability"
              label={labels.slipProbability}
              min="0"
              max="1"
              step="0.05"
              value="0"
              lang="en"></drl-slider>
            <drl-slider
              data-param="initial-value"
              label={labels.initialValue}
              min="-1"
              max="5"
              step="0.1"
              value="0"
              lang="en"></drl-slider>
            <drl-slider
              data-param="candy-reward"
              label={labels.candyReward}
              min="0"
              max="1"
              step="0.05"
              value="0.1"
              lang="en"></drl-slider>
            <drl-slider
              data-param="replay-batch-size"
              label={labels.replayBatchSize}
              min="1"
              max="64"
              step="1"
              value="8"
              lang="en"></drl-slider>
          </div>
        </drl-frozen-lake>

        <drl-frozen-lake-replay lang="en"></drl-frozen-lake-replay>
      </div>
    </section>
  </Fragment>

  <Content />

  <Fragment slot="scripts">
    <script is:inline type="module" src="/demo/drl-demos.js"></script>
    <script is:inline type="module" set:html={frozenLakeGlue}></script>
  </Fragment>
</DemoPage>
