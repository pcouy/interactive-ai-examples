---
import { drlPalette } from '../../../src/styles/token-values.js';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const {
  title,
  description = "Démonstrations interactives pour comprendre l'apprentissage par renforcement et la recherche adversariale.",
  wide = false,
} = Astro.props;

const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/+$/, '');
const current =
  cleanPath === '' || cleanPath === '/index' ? 'home' : cleanPath.replace(/^\//, '');

const siteName = "Jouer pour comprendre l'IA";
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
// `Astro.url.pathname` is absolute, so joining it directly to `Astro.site` would
// drop the GitHub Pages subpath. Join the site path explicitly instead.
const siteBase = Astro.site ?? Astro.url;
const canonicalPath = Astro.url.pathname.replace(/\/index\.html$/, '/');
const canonical = new URL(
  `${siteBase.pathname.replace(/\/+$/, '')}${canonicalPath}`,
  siteBase.origin,
);
---

<!doctype html>
<html lang="fr" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="author" content="Pierre Couy" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta
      name="theme-color"
      content={drlPalette.light.bg}
      data-light={drlPalette.light.bg}
      data-dark={drlPalette.dark.bg}
    />
    <script defer data-domain="pierre-couy.dev" src="https://coucou.pierre-couy.fr/js/script.js"></script>
    <script is:inline>
      (() => {
        const KEY = 'drl-theme';
        const root = document.documentElement;
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const themeMeta = document.querySelector('meta[name="theme-color"]');

        let stored = null;
        try {
          const saved = localStorage.getItem(KEY);
          if (saved === 'dark' || saved === 'light') stored = saved;
        } catch {
          stored = null;
        }

        const labelFor = (theme) =>
          theme === 'dark' ? 'Passer au thème clair' : 'Passer au thème sombre';

        const applyThemeColor = (theme) => {
          if (!themeMeta) return;
          const value = theme === 'dark' ? themeMeta.dataset.dark : themeMeta.dataset.light;
          if (value) themeMeta.setAttribute('content', value);
        };

        root.dataset.theme = stored ?? (media.matches ? 'dark' : 'light');
        applyThemeColor(root.dataset.theme);

        const syncToggle = () => {
          const theme = root.dataset.theme === 'dark' ? 'dark' : 'light';
          const button = document.querySelector('[data-theme-toggle]');
          if (!button) return;

          button.setAttribute('aria-pressed', String(theme === 'dark'));
          button.setAttribute('aria-label', labelFor(theme));

          const label = button.querySelector('[data-theme-label]');
          if (label) label.textContent = labelFor(theme);
        };

        window.__drlSyncThemeToggle = syncToggle;

        const apply = (theme, persist) => {
          root.dataset.theme = theme;
          applyThemeColor(theme);
          syncToggle();

          if (persist) {
            try {
              localStorage.setItem(KEY, theme);
            } catch {
              /* Storage can be unavailable in private or sandboxed contexts. */
            }
          }
        };

        const start = () => {
          apply(root.dataset.theme === 'dark' ? 'dark' : 'light', false);

          const button = document.querySelector('[data-theme-toggle]');
          if (button) {
            button.addEventListener('click', () => {
              apply(root.dataset.theme === 'dark' ? 'light' : 'dark', true);
            });
          }

          if (!stored) {
            media.addEventListener('change', (event) => {
              let saved = null;
              try {
                saved = localStorage.getItem(KEY);
              } catch {
                saved = null;
              }
              if (!saved) apply(event.matches ? 'dark' : 'light', false);
            });
          }
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', start, { once: true });
        } else {
          start();
        }
      })();
    </script>
    <link rel="stylesheet" href="/katex/katex.min.css" />
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <Header current={current} />
    <main id="main" class={wide ? 'page-wide' : 'page'} tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
