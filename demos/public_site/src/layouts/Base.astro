---
import { drlPalette } from '../../../src/styles/token-values.js';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import {
  DEFAULT_LANG,
  absoluteUrl,
  pageFromPath,
  relativeHref,
  routeFor,
  ui,
  type Lang,
} from '../i18n/site';
import langInit from '../scripts/lang-init.js?raw';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  lang?: Lang;
}

const {
  title,
  lang = DEFAULT_LANG,
  description = ui[lang].description,
  wide = false,
} = Astro.props;

const page = pageFromPath(Astro.url.pathname);

const siteName = ui[lang].siteName;
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
// `Astro.url.pathname` is absolute, so joining it directly to `Astro.site` would
// drop the GitHub Pages subpath. Join the site path explicitly instead.
const siteBase = Astro.site;
if (!siteBase) throw new Error('Set `site` in astro.config.mjs.');

const canonical = absoluteUrl(siteBase, routeFor(lang, page));
const frenchUrl = absoluteUrl(siteBase, routeFor('fr', page));
const englishUrl = absoluteUrl(siteBase, routeFor('en', page));
const alternateLocale = lang === 'fr' ? 'en_US' : 'fr_FR';
const locale = lang === 'fr' ? 'fr_FR' : 'en_US';

const langFr = relativeHref(Astro.url.pathname, routeFor('fr', page));
const langEn = relativeHref(Astro.url.pathname, routeFor('en', page));
---

<!doctype html>
<html
  lang={lang}
  dir="ltr"
  data-lang-fr={langFr}
  data-lang-en={langEn}
  data-theme-label-to-light={ui[lang].themeToLight}
  data-theme-label-to-dark={ui[lang].themeToDark}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={frenchUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={frenchUrl} />
    <meta name="author" content="Pierre Couy" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locale} />
    <meta property="og:locale:alternate" content={alternateLocale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta
      name="theme-color"
      content={drlPalette.light.bg}
      data-light={drlPalette.light.bg}
      data-dark={drlPalette.dark.bg}
    />
    <script defer data-domain="pierre-couy.dev" src="https://coucou.pierre-couy.fr/js/script.js"></script>
    <script is:inline set:html={langInit}></script>
    <script is:inline>
      (() => {
        const KEY = 'drl-theme';
        const root = document.documentElement;
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const themeMeta = document.querySelector('meta[name="theme-color"]');

        let stored = null;
        try {
          const saved = localStorage.getItem(KEY);
          if (saved === 'dark' || saved === 'light') stored = saved;
        } catch {
          stored = null;
        }

        const labelFor = (theme) =>
          theme === 'dark'
            ? root.dataset.themeLabelToLight
            : root.dataset.themeLabelToDark;

        const applyThemeColor = (theme) => {
          if (!themeMeta) return;
          const value = theme === 'dark' ? themeMeta.dataset.dark : themeMeta.dataset.light;
          if (value) themeMeta.setAttribute('content', value);
        };

        root.dataset.theme = stored ?? (media.matches ? 'dark' : 'light');
        applyThemeColor(root.dataset.theme);

        const syncToggle = () => {
          const theme = root.dataset.theme === 'dark' ? 'dark' : 'light';
          const button = document.querySelector('[data-theme-toggle]');
          if (!button) return;

          button.setAttribute('aria-pressed', String(theme === 'dark'));
          button.setAttribute('aria-label', labelFor(theme));

          const label = button.querySelector('[data-theme-label]');
          if (label) label.textContent = labelFor(theme);
        };

        window.__drlSyncThemeToggle = syncToggle;

        const apply = (theme, persist) => {
          root.dataset.theme = theme;
          applyThemeColor(theme);
          syncToggle();

          if (persist) {
            try {
              localStorage.setItem(KEY, theme);
            } catch {
              /* Storage can be unavailable in private or sandboxed contexts. */
            }
          }
        };

        const start = () => {
          apply(root.dataset.theme === 'dark' ? 'dark' : 'light', false);

          const button = document.querySelector('[data-theme-toggle]');
          if (button) {
            button.addEventListener('click', () => {
              apply(root.dataset.theme === 'dark' ? 'light' : 'dark', true);
            });
          }

          if (!stored) {
            media.addEventListener('change', (event) => {
              let saved = null;
              try {
                saved = localStorage.getItem(KEY);
              } catch {
                saved = null;
              }
              if (!saved) apply(event.matches ? 'dark' : 'light', false);
            });
          }
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', start, { once: true });
        } else {
          start();
        }
      })();
    </script>
    <link rel="stylesheet" href="/katex/katex.min.css" />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui[lang].skipLink}</a>
    <Header current={page} lang={lang} />
    <main id="main" class={wide ? 'page-wide' : 'page'} tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
