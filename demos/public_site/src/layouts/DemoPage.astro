---
import { DEFAULT_LANG, routeFor, ui, type Lang } from '../i18n/site';
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  eyebrow: string;
  wide?: boolean;
  lang?: Lang;
}

const { title, description, eyebrow, wide = false, lang = DEFAULT_LANG } = Astro.props;
---

<Base title={title} description={description} wide={wide} lang={lang}>
  <header class="demo-header">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="demo-title">{title}</h1>
      {description && <p class="lede">{description}</p>}
    </div>
  </header>

  <slot name="demo" />

  <article class="prose">
    <slot />
  </article>

  <p>
    <a class="button button--ghost" href={routeFor(lang, 'home')}>
      {ui[lang].allDemos}
    </a>
  </p>

  <slot name="scripts" />
</Base>
