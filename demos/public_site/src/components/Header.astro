---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  current?: string;
}

const { current } = Astro.props;

const links = [
  { id: 'home', label: 'Accueil', href: '/' },
  { id: 'deep-blue', label: 'Deep Blue', href: '/deep-blue' },
  { id: 'frozen-lake', label: 'Frozen Lake', href: '/frozen-lake' },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href="/">
      <span class="site-brand__mark" aria-hidden="true"></span>
      Comprendre l'IA par l'exemple
    </a>
    <nav class="site-nav" aria-label="Navigation principale">
      {
        links.map((link) => (
          <a href={link.href} aria-current={current === link.id ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
      <a class="site-back" href="https://pierre-couy.dev">← Retour au blog</a>
    </nav>
    <ThemeToggle />
  </div>
</header>
