---
import { DEFAULT_LANG, routeFor, ui, type Lang } from '../i18n/site';

interface Props {
  lang?: Lang;
}

const { lang = DEFAULT_LANG } = Astro.props;
const year = new Date().getFullYear();

const links = [
  { label: ui[lang].nav.home, href: routeFor(lang, 'home') },
  { label: ui[lang].nav.deepBlue, href: routeFor(lang, 'deep-blue') },
  { label: ui[lang].nav.frozenLake, href: routeFor(lang, 'frozen-lake') },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <a class="site-brand" href={routeFor(lang, 'home')}>
        <span class="site-brand__mark" aria-hidden="true"></span>
        {ui[lang].brand}
      </a>
      <p>{ui[lang].footerTagline}</p>
    </div>
    <nav class="site-footer__nav" aria-label={ui[lang].footerNavLabel}>
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <nav class="site-footer__links" aria-label={ui[lang].footerLinksLabel}>
      <h2 class="site-footer__heading">{ui[lang].footerHeading}</h2>
      <ul>
        <li>
          <a href="https://pierre-couy.dev" target="_blank" rel="noopener noreferrer">
            {ui[lang].externalSite}<span class="sr-only">{ui[lang].newTabSuffix}</span>
          </a>
        </li>
        <li>
          <a
            href="https://github.com/pcouy/interactive-ai-examples"
            target="_blank"
            rel="noopener noreferrer"
          >
            {ui[lang].externalGithub}<span class="sr-only">{ui[lang].newTabSuffix}</span>
          </a>
        </li>
      </ul>
    </nav>
    <p class="site-footer__meta">© {year} Pierre Couy</p>
  </div>
</footer>
