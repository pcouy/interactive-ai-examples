{
  "name": "public-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "sync": "node scripts/sync-demo-assets.mjs",
    "predev": "npm --prefix .. run build && node scripts/sync-demo-assets.mjs",
    "dev": "astro dev",
    "prebuild": "npm --prefix .. run build && node scripts/sync-demo-assets.mjs",
    "build": "astro build && node scripts/finalize-build.mjs && node scripts/verify-build.mjs",
    "preview": "astro preview",
    "precheck": "npm --prefix .. run build && node scripts/sync-demo-assets.mjs",
    "check": "astro check",
    "test": "node --experimental-strip-types --test scripts/url-rewrite.test.mjs scripts/site.test.mjs scripts/lang-init.test.mjs scripts/demo-log.test.mjs",
    "verify": "npm run check && npm run test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "verify:full": "npm run verify && npm run smoke"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "astro": "^7.4.1",
    "katex": "^0.16.47",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3"
  }
}
