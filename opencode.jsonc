{
  "$schema": "https://opencode.ai/config.json",
  // OpenCode disables LSP by default. Enabling it activates the built-in language
  // servers; in this repo the relevant one is `typescript` (demos/ has a
  // tsconfig.json and a `typescript` dependency in demos/package.json).
  "lsp": true,
  "experimental": {
      "subagent_depth": 2
  },

  // Model aliases for the `opencode-go` provider (the OpenCode Go subscription).
  // Agents reference `opencode-go/weak` and `opencode-go/strong`, so changing a
  // `modelID` here repoints every agent that uses the alias. Capabilities and
  // limits come from models.dev.
  "providers": {
    "opencode-go": {
      "models": {
        "weak": {
          "modelID": "longcat-2.5-preview-free",
          // "modelID": "deepseek-4.1-flash-free",
          "name": "Weak",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "video", "pdf"],
            "output": ["text"],
            "reasoning": { "supported": true, "effort": ["low", "high", "max"] },
          },
          "limit": { "context": 1000000, "output": 131072 },
        },
        "strong": {
          "modelID": "longcat-2.5-preview-free",
          "name": "Strong",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
            "reasoning": { "supported": true, "effort": ["none", "low", "medium", "high", "xhigh", "max"] },
          },
          "limit": { "context": 1050000, "input": 922000, "output": 128000 },
        },
      },
    },
  },
}
